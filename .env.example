# Copy this file to ".env" and paste your Google AI API key.
# NEVER commit the real ".env" file (it is in .gitignore).

# Your Google Generative AI API key from Google AI Studio.
# Example: AIzaSy...
GOOGLE_API_KEY=

# Model to use (optional). Defaults to gemini-pro.
GOOGLE_MODEL=gemini-pro

# Optional: set to "true" only if you test the frontend from a different
# origin and need CORS enabled. Leave blank for the normal setup.
# ENABLE_CORS=false

# Optional: set to "true" to run in demo mode - the app returns sample
# quests without calling Google AI. Great for presentations before your
# API key is added. Never use it in a real deployment.
# DEMO_MODE=false
